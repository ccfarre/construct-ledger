#!/usr/bin/env python3
"""Turn canon.jsonl + ledger.sqlite into the static assets the overlap page serves.

Writes, into --out:
  constructs.json  one row per canonical construct, with the longest observed
                   definition, provenance metadata and the retained dissent rates
  edges.json       canonical construct pairs the corpus asserts, with the number
                   of distinct papers asserting each, direction kept separately
  meta.json        corpus-level counts the page quotes in its header and notes

Nothing here calls an API and nothing here costs money.
"""
import argparse, collections, json, os, re, sqlite3, sys

WS = re.compile(r"\s+")
PUNCT = re.compile(r"[^a-z0-9\- ]+")

def norm(s):
    s = PUNCT.sub(" ", (s or "").lower())
    return WS.sub(" ", s).strip()

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--canon", required=True)
    ap.add_argument("--db", required=True, help="ledger.sqlite, source of definitions and relationships")
    ap.add_argument("--out", required=True)
    ap.add_argument("--min-mentions", type=int, default=1)
    a = ap.parse_args()

    C = [json.loads(l) for l in open(a.canon, encoding="utf-8") if l.strip()]
    C = [c for c in C if c["n_mentions"] >= a.min_mentions]
    print("canonical constructs: %d" % len(C))

    # surface form -> canonical, for both definition lookup and relationship mapping
    owner = {}
    for c in C:
        forms = set(c.get("surface_forms") or [])
        forms.add(c["canonical"])
        for f in forms:
            k = norm(f)
            if k:
                owner.setdefault(k, c["canonical"])

    defs, role_count = {}, collections.defaultdict(collections.Counter)
    pair_papers = collections.defaultdict(set)   # (a,b) directed -> doc ids
    db = sqlite3.connect(a.db)
    seen = 0
    for doc_id, js in db.execute("SELECT doc_id, json FROM results"):
        try:
            o = json.loads(js)
        except Exception:
            continue
        seen += 1
        for con in (o.get("constructs") or []):
            k = norm(con.get("name"))
            tgt = owner.get(k)
            if not tgt:
                continue
            d = (con.get("definition") or "").strip()
            if d and len(d) > len(defs.get(tgt, "")):
                defs[tgt] = d
            r = (con.get("structural_role") or con.get("role") or "").strip().lower()
            if r:
                role_count[tgt][r] += 1
        for rel in (o.get("relationships") or []):
            s, t = owner.get(norm(rel.get("from"))), owner.get(norm(rel.get("to")))
            if s and t and s != t:
                pair_papers[(s, t)].add(doc_id)
    print("documents read: %d | definitions recovered: %d" % (seen, len(defs)))

    idx = {c["canonical"]: i for i, c in enumerate(C)}
    rows = []
    for c in C:
        name = c["canonical"]
        rows.append({
            "n": name,
            "f": sorted({norm(x) for x in (c.get("surface_forms") or []) if norm(x) and norm(x) != norm(name)}),
            "d": defs.get(name, ""),
            "y0": c.get("first_year"), "y1": c.get("last_year"),
            "j": sorted(c.get("journals") or []),
            "m": c["n_mentions"],
            "o": c.get("origin"), "od": c.get("origin_discipline") or "",
            "ox": round(float(c.get("origin_dissent") or 0), 3),
            "p": c.get("proximity"),
            "px": round(float(c.get("proximity_dissent") or 0), 3),
            "r": role_count[name].most_common(1)[0][0] if role_count[name] else "",
        })

    # One edge per unordered construct pair. The replication count is the number
    # of DISTINCT papers asserting that pair in either direction, which is the
    # definition Section 5.3 of the paper uses; the directed split is kept only
    # so the page can show which way round the field states the proposition.
    und_docs = collections.defaultdict(set)
    und_dir = collections.defaultdict(lambda: [0, 0])
    for (s, t), docs in pair_papers.items():
        if s not in idx or t not in idx:
            continue
        i, j = idx[s], idx[t]
        key = (i, j) if i < j else (j, i)
        und_docs[key] |= docs
        und_dir[key][0 if i < j else 1] += len(docs)
    edges = [[i, j, len(und_docs[(i, j)]), und_dir[(i, j)][0], und_dir[(i, j)][1]]
             for (i, j) in sorted(und_docs)]
    replicated = sum(1 for e in edges if e[2] >= 2)

    meta = {
        "constructs": len(rows),
        "documents": seen,
        "surface_forms": sum(len(r["f"]) for r in rows) + len(rows),
        "pairs": len(edges),
        "replicated_pairs": replicated,
        "recurring": sum(1 for r in rows if r["m"] >= 2),
        "single_use": sum(1 for r in rows if r["m"] == 1),
        "shared_vocabulary": sum(1 for r in rows if len(r["j"]) >= 4),
        "journals": sorted({j for r in rows for j in r["j"]}),
        "seen_3plus": len([r for r in rows if r["m"] >= 3]),
        "mean_origin_dissent_3plus": round(
            sum(r["ox"] for r in rows if r["m"] >= 3) / max(1, len([r for r in rows if r["m"] >= 3])), 3),
        "mean_proximity_dissent_3plus": round(
            sum(r["px"] for r in rows if r["m"] >= 3) / max(1, len([r for r in rows if r["m"] >= 3])), 3),
    }

    os.makedirs(a.out, exist_ok=True)
    for fn, obj in (("constructs.json", rows), ("edges.json", edges), ("meta.json", meta)):
        path = os.path.join(a.out, fn)
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, separators=(",", ":"), ensure_ascii=False)
        print("wrote %-18s %8.2f MB" % (fn, os.path.getsize(path) / 1e6))
    print(json.dumps(meta, indent=1)[:600])

if __name__ == "__main__":
    main()
