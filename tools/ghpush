#!/usr/bin/env python3
"""ghpush: publish a folder to a GitHub repository without git installed.

For a machine where the Git for Windows installer needs administrator rights.
Uses GitHub's git data API: a blob per file, one tree, one commit, one ref
update. Python standard library only.

The push REPLACES the branch's tree with the contents of the folder, which is
what you want when a site is rebuilt from scratch, and is not what you want on
a repository holding anything the folder does not. It prints what it will do
and sends nothing without --go.

    set GITHUB_TOKEN=...        (fine-grained token, Contents read and write)
    python ghpush --repo ccfarre/construct-ledger --dir . --message "..."
    python ghpush --repo ccfarre/construct-ledger --dir . --message "..." --go
"""
import argparse, base64, json, os, sys, time, urllib.error, urllib.request

API = "https://api.github.com"
SKIP_DIRS = {".git", "__pycache__", ".ipynb_checkpoints", ".vscode", "node_modules"}
SKIP_FILES = {".DS_Store", "Thumbs.db"}
TOOL = "ghpush/1.0"


def log(s):
    sys.stderr.write(s + "\n")
    sys.stderr.flush()


def call(method, url, token, payload=None, tries=5):
    data = json.dumps(payload).encode("utf-8") if payload is not None else None
    for attempt in range(tries):
        req = urllib.request.Request(url, data=data, method=method, headers={
            "Authorization": "Bearer " + token,
            "Accept": "application/vnd.github+json",
            "X-GitHub-Api-Version": "2022-11-28",
            "Content-Type": "application/json",
            "User-Agent": TOOL})
        try:
            with urllib.request.urlopen(req, timeout=120) as r:
                return json.loads(r.read().decode("utf-8") or "{}")
        except urllib.error.HTTPError as e:
            body = ""
            try:
                body = e.read().decode("utf-8", "replace")
            except Exception:  # noqa: BLE001
                pass
            if e.code in (403, 429) and attempt < tries - 1:
                wait = min(2 ** (attempt + 1), 30)
                log("  rate limited, waiting %ds" % wait)
                time.sleep(wait)
                continue
            if e.code == 401:
                raise SystemExit("fatal: the token was rejected. Check GITHUB_TOKEN and that "
                                 "it grants Contents read and write on this repository.")
            if e.code == 404:
                raise SystemExit("fatal: %s not found, or the token cannot see it." % url)
            raise SystemExit("fatal: HTTP %s on %s\n%s" % (e.code, url, body[:600]))
        except Exception as e:  # noqa: BLE001
            if attempt < tries - 1:
                wait = min(2 ** (attempt + 1), 30)
                log("  %s, retrying in %ds" % (type(e).__name__, wait))
                time.sleep(wait)
                continue
            raise
    raise SystemExit("fatal: gave up on " + url)


def collect(root):
    out = []
    for base, dirs, files in os.walk(root):
        dirs[:] = sorted(d for d in dirs if d not in SKIP_DIRS)
        for f in sorted(files):
            if f in SKIP_FILES:
                continue
            full = os.path.join(base, f)
            rel = os.path.relpath(full, root).replace(os.sep, "/")
            out.append((rel, full, os.path.getsize(full)))
    return out


def main():
    ap = argparse.ArgumentParser(prog="ghpush")
    ap.add_argument("--repo", required=True, help="owner/name")
    ap.add_argument("--dir", default=".")
    ap.add_argument("--branch", default="main")
    ap.add_argument("--message", default="Update from ghpush")
    ap.add_argument("--go", action="store_true")
    a = ap.parse_args()

    token = (os.environ.get("GITHUB_TOKEN") or os.environ.get("GH_TOKEN") or "").strip()
    files = collect(os.path.abspath(a.dir))
    total = sum(s for _, _, s in files)

    log("ghpush")
    log("  repository            %s" % a.repo)
    log("  branch                %s" % a.branch)
    log("  folder                %s" % os.path.abspath(a.dir))
    log("  files                 %d" % len(files))
    log("  bytes                 %.1f MB" % (total / 1e6))
    big = [f for f in files if f[2] > 40e6]
    for rel, _, s in big:
        log("  WARNING %s is %.1f MB; the API limit is 100 MB" % (rel, s / 1e6))
    log("")
    log("  This replaces everything on %s with the folder above. Files in the" % a.branch)
    log("  repository that are not in the folder will be gone from the new commit.")
    if not a.go:
        log("")
        log("  Nothing was sent. Re-run with --go.")
        return
    if not token:
        raise SystemExit("fatal: GITHUB_TOKEN is not set")

    base_url = "%s/repos/%s" % (API, a.repo)
    ref = call("GET", "%s/git/ref/heads/%s" % (base_url, a.branch), token)
    parent = ref["object"]["sha"]
    log("  parent commit         %s" % parent[:10])

    tree = []
    for i, (rel, full, _size) in enumerate(files, 1):
        with open(full, "rb") as fh:
            raw = fh.read()
        blob = call("POST", base_url + "/git/blobs", token, {
            "content": base64.b64encode(raw).decode("ascii"), "encoding": "base64"})
        tree.append({"path": rel, "mode": "100644", "type": "blob", "sha": blob["sha"]})
        if i % 25 == 0 or i == len(files):
            log("  uploaded              %d/%d" % (i, len(files)))

    t = call("POST", base_url + "/git/trees", token, {"tree": tree})
    c = call("POST", base_url + "/git/commits", token,
             {"message": a.message, "tree": t["sha"], "parents": [parent]})
    call("PATCH", "%s/git/refs/heads/%s" % (base_url, a.branch), token,
         {"sha": c["sha"], "force": False})

    log("")
    log("  new commit            %s" % c["sha"][:10])
    log("  done                  https://github.com/%s/commit/%s" % (a.repo, c["sha"]))
    log("")
    log("  If Pages is already enabled it will rebuild within a minute or two.")


if __name__ == "__main__":
    main()
